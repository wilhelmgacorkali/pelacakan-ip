APP_NAME="GeoTrack Pro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://enable-wiring-sample.ngrok-free.dev

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120


# Phone Intelligence (server-side)
# Daftar API key IPQS: https://www.ipqualityscore.com/
PHONE_LOOKUP_PROVIDER=ipqs
PHONE_LOOKUP_API_KEY=
PHONE_LOOKUP_API_URL=https://www.ipqualityscore.com/api/json/phone
PHONE_LOOKUP_TIMEOUT=8
PHONE_LOOKUP_STRICTNESS=0

# Dipakai untuk geocoding city/region ke titik peta (bukan GPS perangkat)
GEOCODER_USER_AGENT="GeoTrack-Pro/1.0 contact-admin@example.com"

# Device Tracker
DEVICE_TRACKER_AGENT_INTERVAL=5
DEVICE_TRACKER_ONLINE_WINDOW=2

# Ngrok tunnel (dipakai oleh: php artisan tracker:tunnel)
# Authtoken dari https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_BINARY=ngrok
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
